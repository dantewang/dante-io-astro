---
import PostList from '../../../../../components/PostList.astro';
import { getPosts, paginate, tagCounts, tagUrl } from '../../../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = tagCounts(posts);
  return tags.flatMap(({ tag }) => {
    const tagged = posts.filter(p => p.data.tags.includes(tag));
    const chunks = paginate(tagged);
    return chunks.slice(1).map((chunk, i) => ({
      params: { tag, page: String(i + 2) },
      props: { tag, chunk, page: i + 2, pages: chunks.length, total: tagged.length, tags },
    }));
  });
}
const { tag, chunk, page, pages, total, tags } = Astro.props;
---
<PostList posts={chunk} page={page} pages={pages} base={tagUrl(tag)} total={total} tags={tags} tag={tag} />
