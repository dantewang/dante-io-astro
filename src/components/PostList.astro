---
// One page of the blog index or of a tag: masthead, tag chips, posts grouped
// by year, pager. Used by the pages under src/pages/blog/.
import site from 'virtual:site-config';
import BlogLayout from '../layouts/BlogLayout.astro';
import { inline } from '../lib/inline';
import { dateParts, excerpt, pageUrl, postUrl, readingMinutes, tagUrl, type Post } from '../lib/posts';

interface Props {
  posts: Post[];                 // this page's posts
  page: number;                  // 1-based
  pages: number;
  base: string;                  // /blog/ or /blog/tags/<tag>/
  total: number;                 // posts in this listing
  tags: { tag: string; count: number }[];
  tag?: string;
}
const { posts, page, pages, base, total, tags, tag } = Astro.props;

// group this page's posts by year (in the configured time zone)
const years: { year: string; posts: Post[] }[] = [];
for (const p of posts) {
  const year = dateParts(p.data.date).year;
  if (years.at(-1)?.year !== year) years.push({ year, posts: [] });
  years.at(-1)!.posts.push(p);
}

const title = (tag ? `#${tag} · ` : '') + '博客' + (page > 1 ? ` · 第 ${page} 页` : '') + ' · DANTE';
const pageLinks = Array.from({ length: pages }, (_, i) => i + 1);
---
<BlogLayout title={title}>
  <main>
    <section class="masthead">
      <canvas class="ambient" aria-hidden="true"></canvas>
      <p class="eyebrow">{tag ? `~/blog/tags/${tag}` : '~/blog'} · 写给未来的自己</p>
      <h1 class="display">{tag ? `#${tag}` : 'BLOG'}<span class="caret" aria-hidden="true"></span></h1>
      {!tag && <p class="lede" set:html={inline(site.blog.intro)} />}
      <p class="stats">// {total} 篇{pages > 1 && ` · 第 ${page} / ${pages} 页`} · <a href="/rss.xml">RSS</a></p>

      {tags.length > 0 && (
        <nav class="filters" aria-label="按标签浏览">
          <a href="/blog/" aria-current={!tag ? 'page' : undefined}>全部</a>
          {tags.map(t => <a href={tagUrl(t.tag)} aria-current={t.tag === tag ? 'page' : undefined}>#{t.tag}</a>)}
        </nav>
      )}
    </section>

    <div class="archive">
      {years.map(y => (
        <section class="year" aria-label={y.year}>
          <h2 class="year-label">{y.year}</h2>
          <ol class="posts">
            {y.posts.map(p => {
              const d = dateParts(p.data.date);
              return (
                <li class="post">
                  <a href={postUrl(p)}>
                    <time datetime={p.data.date.toISOString()}>{d.month}·{d.day}</time>
                    <div>
                      <h3 lang={p.data.lang}>{p.data.title}</h3>
                      <p lang={p.data.lang}>{excerpt(p)}</p>
                      <div class="post-meta">
                        {p.data.tags.map(t => <span class="tag">#{t}</span>)}
                        <span>约 {readingMinutes(p.body)} 分钟</span>
                      </div>
                    </div>
                    <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12L12 4M5.5 4H12v6.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
                  </a>
                </li>
              );
            })}
          </ol>
        </section>
      ))}

      {pages > 1 && (
        <nav class="pager" aria-label="分页">
          {page > 1 ? <a href={pageUrl(base, page - 1)} rel="prev">← 较新</a> : <span class="off">← 较新</span>}
          <ol>
            {pageLinks.map(n => (
              <li>{n === page
                ? <span aria-current="page">{n}</span>
                : <a href={pageUrl(base, n)}>{n}</a>}</li>
            ))}
          </ol>
          {page < pages ? <a href={pageUrl(base, page + 1)} rel="next">较早 →</a> : <span class="off">较早 →</span>}
        </nav>
      )}
    </div>
  </main>
</BlogLayout>
